      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "合週天之數",
      "block": 2,
      "inline": 0,
      "offset": 77,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "雖不以此補天就該去補地之坑陷使地平坦而不得有此一部鬼話",
      "block": 2,
      "inline": 0,
      "offset": 90,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.4375,
      "color": ""
    },
    {
      "text": "剩了這一塊便生出這許多故事",
      "block": 2,
      "inline": 0,
      "offset": 100,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "煅煉後性",
      "block": 2,
      "inline": 0,
      "offset": 123,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "方通甚哉人生不能學也",
      "block": 2,
      "inline": 0,
      "offset": 127,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "妙自謂落墮情根故無補天之用",
      "block": 2,
      "inline": 0,
      "offset": 127,
      "placement": "top",
      "columns": 2,
      "extent": 8,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "極",
      "block": 3,
      "inline": 0,
      "offset": 101,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "豈敢豈敢",
      "block": 3,
      "inline": 0,
      "offset": 110,
      "placement": "side",
      "columns": 1,
      "extent": 100,
      "flow": true,
      "font_scale": 0.5,
      "color": ""
    },
    {
      "text": "豈敢豈敢",
      "block": 3,
      "inline": 0,
